{
  "name": "gemini-oauth",
  "version": "0.1.0",
  "description": "Turn your Gemini CLI (Code Assist OAuth) session into an OpenAI-compatible local API — the Gemini analogue of openai-oauth / grok-oauth.",
  "type": "module",
  "bin": {
    "gemini-oauth": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "prepare": "npm run build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:consumer": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022 type-tests/consumer.ts",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test && npm run typecheck:consumer",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "pack:local": "npm pack",
    "install:global": "npm run build && npm install -g .",
    "uninstall:global": "npm uninstall -g gemini-oauth"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "gemini",
    "gemini-cli",
    "google",
    "oauth",
    "code-assist",
    "openai-compatible",
    "proxy",
    "cli",
    "server",
    "antigravity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimws/gemini-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/kimws/gemini-oauth/issues"
  },
  "homepage": "https://github.com/kimws/gemini-oauth#readme",
  "preferGlobal": true,
  "dependencies": {
    "@types/node": "^24.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
